---
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  preloadImg?: string;
}

const {
  title = 'RigGamer — PC Gaming Guides, News & Reviews',
  description = 'The sharpest PC gaming coverage. Tier-list guides, patch notes, honest reviews, and setup intel — updated daily.',
  image = '/og-default.jpg',
  noindex = false,
  preloadImg,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="referrer" content="no-referrer" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}

  <!-- OG -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <!-- Fonts — non-render-blocking -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600;700&family=Inter:wght@400;600;700&family=JetBrains+Mono:wght@400;700&display=swap" />
  <link rel="stylesheet" media="print" onload="this.media='all'" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600;700&family=Inter:wght@400;600;700&family=JetBrains+Mono:wght@400;700&display=swap" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600;700&family=Inter:wght@400;600;700&family=JetBrains+Mono:wght@400;700&display=swap" /></noscript>

  <!-- LCP image preload — browser downloads hero before parsing body -->
  {preloadImg && <link rel="preload" as="image" href={preloadImg} fetchpriority="high" media="(min-width: 769px)" />}

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-58ZBC3HB');</script>
</head>
<body>

<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-58ZBC3HB"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<NavBar />

<main>
  <slot />
</main>

<Footer />

<!-- Defer banner images to after LCP — prevents GIFs from being LCP element -->
<script>
(function() {
  function loadBanners() {
    document.querySelectorAll('img[data-src]').forEach(function(img) {
      img.src = img.getAttribute('data-src')!;
      img.removeAttribute('data-src');
    });
  }
  if ('PerformanceObserver' in window) {
    try {
      const po = new PerformanceObserver(function() {
        po.disconnect();
        requestAnimationFrame(loadBanners);
      });
      po.observe({ type: 'largest-contentful-paint', buffered: true });
    } catch(_) { window.addEventListener('load', loadBanners); }
  } else {
    window.addEventListener('load', loadBanners);
  }
})();
</script>

<!-- Affiliate links — open in new tab -->
<script>
document.addEventListener('click', function(e) {
  const a = (e.target as Element).closest('a[href^="/go/"]');
  if (!a) return;
  e.preventDefault();
  window.open((a as HTMLAnchorElement).href, '_blank', 'noopener,noreferrer');
}, true);
</script>

</body>
</html>
