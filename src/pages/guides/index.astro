---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import HubHeader from '../../components/HubHeader.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Banner from '../../components/Banner.astro';
import { getArticlesByCategory } from '../../lib/db';

Astro.response.headers.set('Cache-Control', 'public, max-age=3600, stale-while-revalidate=86400');

const db = Astro.locals.runtime.env.DB;
const articles = await getArticlesByCategory(db, 'guides');
---

<Base title="PC Gaming Guides — RigGamer" description="Step-by-step guides, tier lists, and beginner roadmaps for the biggest PC games.">

  <div style="background:#07080b;padding:22px 0 0;text-align:center;">
    <div class="promo-desktop" style="display:inline-block;line-height:0;">
      <Banner slug="nte" size="wide" img="/media/nte-w.gif" imgW={728} imgH={146} alt="NTE — Play Free" />
    </div>
    <div class="promo-mobile" style="justify-content:center;">
      <Banner slug="nte" size="wide" img="/media/nte-w.gif" imgW={728} imgH={146} alt="NTE — Play Free" />
    </div>
  </div>

  <HubHeader
    cat="guides"
    title="PC Gaming Guides"
    desc="Tier lists, beginner roadmaps, build guides, and strategy breakdowns — updated every week."
    count={articles.length}
    bgImg="https://rigpeak.com/wp-content/uploads/2026/08/24/where-winds-meet-guides.jpg"
  />

  <div class="wrap">
    <div class="page-layout">
      <div>
        <div class="articles-grid">
          {articles.map((a, i) => <ArticleCard {...a} num={i} />)}
        </div>
      </div>
      <aside class="sidebar">
        <Banner slug="nte" size="box" img="/media/nte-b.webp" imgW={300} imgH={250} alt="NTE" />
        <Banner slug="nte" size="sky" img="/media/nte-sky.gif" imgW={160} imgH={600} alt="NTE" />
        <div class="trending-box">
          <div class="trending-hd">Trending</div>
          {articles.slice(0, 4).map((a, i) => (
            <a href={`/guides/${a.slug}/`} class="tr-item">
              <span class="tr-num">{String(i+1).padStart(2,'0')}</span>
              <div>
                <div class="tr-title">{a.title}</div>
                <span class="tr-cat" style="color:var(--cg);font-family:var(--fm);font-size:10px;text-transform:uppercase;letter-spacing:.06em;">Guide</span>
              </div>
            </a>
          ))}
        </div>
      </aside>
    </div>
    <div class="mobile-mid-promo">
      <Banner slug="nte" size="box" img="/media/nte-b.webp" imgW={300} imgH={250} alt="NTE" />
    </div>
  </div>

</Base>
