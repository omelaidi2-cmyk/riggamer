---
export const prerender = false;
import ArticlePage from '../../components/ArticlePage.astro';
import { getArticleBySlug, getArticlesByCategory } from '../../lib/db';

Astro.response.headers.set('Cache-Control', 'public, max-age=86400, stale-while-revalidate=604800');

const { slug } = Astro.params;
const db = Astro.locals.runtime.env.DB;

const article = await getArticleBySlug(db, slug!);
if (!article) return Astro.redirect('/');

const readNext = (await getArticlesByCategory(db, article.cat))
  .filter(a => a.slug !== slug)
  .slice(0, 3);
---
<ArticlePage article={article} readNext={readNext} />
