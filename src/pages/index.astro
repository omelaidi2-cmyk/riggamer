    <li><a class="gx-item" href="/reviews/war-thunder-review/"><img class="gx-logo" src="/media/war-thunder-reviews.webp" alt="War Thunder" loading="lazy"><span class="gx-tip">War Thunder</span></a></li>
    <li><a class="gx-item" href="/reviews/enlisted-review/"><img class="gx-logo" src="/media/enlisted-guides.webp" alt="Enlisted" loading="lazy"><span class="gx-tip">Enlisted</span></a></li>
