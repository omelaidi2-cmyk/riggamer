    <a href="/guides/" class="text-xs font-mono text-[#8a909a] hover:text-[#ff5500] transition-colors uppercase tracking-wider">BROWSE EVERYTHING →</a>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {latest.map((a) => (
      <article class="bg-[#0b0d12] border border-[#181c25] hover:border-[#2b3140] transition flex flex-col group overflow-hidden">
        <div class="relative aspect-video w-full overflow-hidden bg-[#161a24]">
          {a.img ? (
            <img src={a.img} alt={a.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 brightness-90" loading="lazy" />
          ) : (
