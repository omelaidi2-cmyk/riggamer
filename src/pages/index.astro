            <div>
              <a href={`/reviews/${a.slug}/`} class="font-headline text-base sm:text-lg font-bold text-white hover:text-[#ff5500] transition-colors block">{a.title}</a>
              <p class="text-xs text-[#8a909a]">{verdictLine(a.score!, a.excerpt)}</p>
