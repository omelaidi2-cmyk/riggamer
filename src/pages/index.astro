---
export const prerender = false;
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import { getArticlesByCategory, getLatestArticles } from '../lib/db';

Astro.response.headers.set('Cache-Control', 'public, max-age=3600, stale-while-revalidate=86400');

const db = Astro.locals.runtime?.env?.DB;
const [allLatest, reviews] = await Promise.all([
  db ? getLatestArticles(db, 100) : Promise.resolve([]),
  db ? getArticlesByCategory(db, 'reviews') : Promise.resolve([]),
]);

const PER_PAGE = 9;
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1'));
const totalPages = Math.max(1, Math.ceil(allLatest.length / PER_PAGE));
const latest = allLatest.slice((page - 1) * PER_PAGE, page * PER_PAGE);

const topRated = [...reviews]
  .filter(a => a.score)
  .sort((a, b) => parseFloat(b.score!) - parseFloat(a.score!));

const catLabel: Record<string,string> = { guides: 'GUIDE', news: 'NEWS', reviews: 'REVIEW', setup: 'SETUP' };

function verdictLine(score: string, excerpt?: string | null): string {
  const n = parseFloat(score);
  if (excerpt && excerpt.length < 80) return excerpt;
  if (n >= 9) return 'Essential — do not sleep on this one';
  if (n >= 8.5) return 'Must play for the genre';
  if (n >= 8) return 'Worth it, with caveats';
  if (n >= 7.5) return 'Solid pick for the right player';
  if (n >= 7) return "Decent, skip if the genre isn't your thing";
  return 'Approach with low expectations';
}

const belt3d = [
  { title: 'War Thunder',           genre: 'MILITARY SIM',    slug: 'war-thunder-review',                  cat: 'reviews', img: '/media/war-thunder-reviews.webp' },
  { title: 'Arknights: Endfield',   genre: '3D ACTION RPG',   slug: 'arknights-endfield-review',           cat: 'reviews', img: '/media/arknights-endfield-review-2026.webp' },
  { title: 'Neverness to Everness', genre: 'URBAN OPEN WORLD',slug: 'neverness-to-everness-review-2026',   cat: 'reviews', img: '/media/nte-review-keyart.webp' },
  { title: 'Star Trek: FC',         genre: 'SCI-FI 4X',       slug: 'star-trek-fleet-command-review',      cat: 'reviews', img: '/media/star-trek-fleet-command-reviews.webp' },
  { title: 'Enlisted',              genre: 'TACTICAL FPS',    slug: 'enlisted-review',                     cat: 'reviews', img: '/media/enlisted-guides.webp' },
  { title: 'Raid: Shadow Legends',  genre: 'TURN-BASED RPG',  slug: 'raid-shadow-legends-review',          cat: 'reviews', img: '/media/raid-shadow-legends-guides.webp' },
  { title: 'Rise of Kingdoms',      genre: 'STRATEGY 4X',     slug: 'rise-of-kingdoms-review',             cat: 'reviews', img: '/media/rise-of-kingdoms-guides.webp' },
  { title: 'Where Winds Meet',      genre: 'OPEN WORLD RPG',  slug: 'where-winds-meet-review',             cat: 'reviews', img: '/media/where-winds-meet-reviews.webp' },
];
---

<Base
  title="RigGamer"
  description="Honest reviews, PC setup guides, and tier lists for the free-to-play games worth your evening. Patch-verified builds, monetization audits, and rig benchmarks updated every week."
