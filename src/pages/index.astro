            <div class="w-full max-w-[200px] sm:max-w-[280px] bg-[#1a1e29] h-1.5 rounded-full overflow-hidden">
              <div class="h-full rounded-full" style={`width:${parseFloat(a.score!)*10}%;background:#ff5500`}></div>
            </div>
            <span class="font-headline text-lg sm:text-2xl font-black text-white w-10 text-right shrink-0">{a.score}</span>
          </div>
        </div>
      ))}
    </div>
  ) : (
    <p class="text-[#8a909a] font-mono text-xs">No reviews yet.</p>
  )}
</section>

<!-- 3D CINEMATIC BELT + CTA -->
