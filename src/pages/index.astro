      </article>
    ))}
  </div>

  <!-- PAGINATION -->
  {totalPages > 1 && (
    <div class="flex items-center justify-center gap-2 font-mono text-xs pt-8 mt-4 border-t border-white/10">
      {page > 1 ? (
        <a href={`/?page=${page - 1}`} class="w-9 h-9 flex items-center justify-center bg-[#111318] border border-white/10 hover:border-[#ff5500] text-white/60 hover:text-white transition-colors">←</a>
      ) : (
        <span class="w-9 h-9 flex items-center justify-center bg-[#111318] border border-white/5 text-white/20 cursor-not-allowed">←</span>
      )}
      {Array.from({ length: totalPages }, (_, i) => i + 1).map(p => (
        <a href={`/?page=${p}`} class={`w-9 h-9 flex items-center justify-center border font-bold transition-colors ${p === page ? 'bg-[#ff5500] border-[#ff5500] text-white' : 'bg-[#111318] border-white/10 text-white/60 hover:border-[#ff5500] hover:text-white'}`}>
          {String(p).padStart(2, '0')}
        </a>
      ))}
      {page < totalPages ? (
        <a href={`/?page=${page + 1}`} class="w-9 h-9 flex items-center justify-center bg-[#111318] border border-white/10 hover:border-[#ff5500] text-white/60 hover:text-white transition-colors">→</a>
      ) : (
        <span class="w-9 h-9 flex items-center justify-center bg-[#111318] border border-white/5 text-white/20 cursor-not-allowed">→</span>
      )}
