        <div class="p-5 flex flex-col flex-1 justify-between">
          <div>
            <h3 class="font-headline text-lg font-bold text-white group-hover:text-[#ff5500] transition-colors leading-snug mb-4">
              <a href={`/${a.cat}/${a.slug}/`}>{a.title}</a>
