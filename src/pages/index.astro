      Ranked by our <span class="italic" style="color:#ff5500">score</span>
    </h2>
  </div>
  {topRated.length > 0 ? (
    <div class="flex flex-col divide-y divide-[#161a24] border-t border-b border-[#161a24]">
      {topRated.slice(0, 8).map((a, i) => (
        <div class="py-4 sm:py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4 hover:bg-[#0c0e14] px-3 transition">
