</section>

<!-- GAME LOGOS MARQUEE -->
<!-- LOGO BAND -->
<style>
.gx-band{--hot:#ff5500;--on-hot:#000;max-width:1200px;margin:0 auto;padding:2.2rem 0;overflow:hidden;
  -webkit-mask-image:linear-gradient(90deg,transparent 0%,#000 9%,#000 91%,transparent 100%);
          mask-image:linear-gradient(90deg,transparent 0%,#000 9%,#000 91%,transparent 100%);}
.gx-row{display:flex;align-items:center;width:max-content;margin:0;padding:0;list-style:none;
  animation:gx-scroll 45s linear infinite;}
.gx-band:hover .gx-row,.gx-band:focus-within .gx-row{animation-play-state:paused;}
@keyframes gx-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.gx-row li{flex:0 0 auto;display:flex;justify-content:center;padding:0 clamp(1.25rem,.75rem + 1.5vw,2.25rem);}
.gx-item{position:relative;display:flex;align-items:center;justify-content:center;width:7rem;height:3.5rem;text-decoration:none;outline-offset:6px;}
.gx-logo{display:block;width:100%;height:100%;object-fit:cover;border-radius:4px;
  filter:brightness(.75) saturate(.85);opacity:.85;
  transition:filter .45s ease,opacity .45s ease,transform .45s ease;}
.gx-item:hover .gx-logo,.gx-item:focus-visible .gx-logo{
  filter:brightness(1.05) saturate(1.2) drop-shadow(0 0 10px rgba(255,85,0,.7));
  opacity:1;transform:translateY(-3px) scale(1.06);}
.gx-tip{position:absolute;bottom:calc(100% + .7rem);left:50%;transform:translate(-50%,6px);
  white-space:nowrap;padding:.3rem .6rem;font:700 11px/1.2 system-ui,sans-serif;letter-spacing:.06em;text-transform:uppercase;
  color:var(--on-hot);background:var(--hot);box-shadow:0 0 18px rgba(255,85,0,.45);
  opacity:0;pointer-events:none;transition:opacity .3s ease,transform .4s ease;}
.gx-tip::after{content:"";position:absolute;top:100%;left:50%;width:8px;height:8px;background:var(--hot);
  transform:translate(-50%,-50%) rotate(45deg);}
.gx-item:hover .gx-tip,.gx-item:focus-visible .gx-tip{opacity:1;transform:translate(-50%,0);}
@media (prefers-reduced-motion:reduce){.gx-row{animation:none;flex-wrap:wrap;width:auto;justify-content:center}.gx-row li[aria-hidden]{display:none}}
</style>

