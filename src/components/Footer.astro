---
const year = new Date().getFullYear();
---
<footer class="relative z-20 bg-[#0c0e12] border-t border-white/10 text-gray-300 text-xs font-mono antialiased py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- MAIN ROW — all columns on one line -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6 mb-6 pb-6 border-b border-white/5">

      <!-- Logo + tagline -->
      <div>
        <a href="/" class="inline-flex items-center gap-2 mb-2">
          <div class="w-5 h-5 flex items-center justify-center shrink-0" style="background:#ff5500;border-radius:3px;">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none">
              <path d="M12 2L2 7l10 5 10-5-10-5z" stroke="#fff" stroke-width="2" stroke-linejoin="round"/>
              <path d="M2 12l10 5 10-5" stroke="#fff" stroke-width="2" stroke-linejoin="round"/>
              <path d="M2 17l10 5 10-5" stroke="#fff" stroke-width="2" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="font-black text-sm uppercase font-mono"><span class="text-white">RIG</span><span style="color:#ff5500">GAMER</span></span>
        </a>
        <p class="text-[#596373] text-[10px] leading-relaxed">Independent PC gaming desk.</p>
      </div>

      <!-- Sections -->
      <div>
        <h4 class="font-bold text-white uppercase tracking-widest mb-2 text-[10px]">SECTIONS</h4>
        <ul class="space-y-1.5 text-[#8a909a] text-[10px]">
          <li><a href="/guides/"  class="hover:text-[#ff5500] transition-colors">Guides</a></li>
          <li><a href="/news/"    class="hover:text-[#ff5500] transition-colors">News</a></li>
          <li><a href="/reviews/" class="hover:text-[#ff5500] transition-colors">Reviews</a></li>
          <li><a href="/setup/"   class="hover:text-[#ff5500] transition-colors">Setup</a></li>
        </ul>
      </div>

      <!-- Ethics -->
      <div>
        <h4 class="font-bold text-white uppercase tracking-widest mb-2 text-[10px]">ETHICS</h4>
        <ul class="space-y-1.5 text-[#8a909a] text-[10px]">
          <li><a href="/about/"      class="hover:text-[#ff5500] transition-colors">Editorial charter</a></li>
          <li><a href="/disclosure/" class="hover:text-[#ff5500] transition-colors">Affiliate disclosure</a></li>
          <li><a href="/privacy/"    class="hover:text-[#ff5500] transition-colors">Privacy</a></li>
        </ul>
      </div>

      <!-- About Us -->
      <div>
        <h4 class="font-bold text-white uppercase tracking-widest mb-2 text-[10px]">ABOUT US</h4>
        <p class="text-[#596373] text-[10px] leading-relaxed">Independent bench-testing desk. No paywalls, no embargoes.</p>
        <div id="about-more" class="hidden mt-1">
          <p class="text-[#596373] text-[10px] leading-relaxed">Founded 2024. Covers military sims, gacha RPGs, strategy &amp; PC hardware.</p>
        </div>
        <button onclick="const el=document.getElementById('about-more');el.classList.toggle('hidden');this.textContent=el.classList.contains('hidden')?'More →':'Less ↑';"
          class="text-[#ff5500] text-[10px] mt-1 cursor-pointer bg-transparent border-none font-mono hover:underline p-0">More →</button>
      </div>

      <!-- Terms -->
      <div>
        <h4 class="font-bold text-white uppercase tracking-widest mb-2 text-[10px]">TERMS</h4>
        <p class="text-[#596373] text-[10px] leading-relaxed">Content is for informational use only. Affiliate links disclosed.</p>
        <div id="terms-more" class="hidden mt-1">
          <p class="text-[#596373] text-[10px] leading-relaxed">We don't accept sponsored reviews. Trademarks belong to their owners. <a href="/privacy/" class="text-[#ff5500]">Privacy →</a></p>
        </div>
        <button onclick="const el=document.getElementById('terms-more');el.classList.toggle('hidden');this.textContent=el.classList.contains('hidden')?'More →':'Less ↑';"
          class="text-[#ff5500] text-[10px] mt-1 cursor-pointer bg-transparent border-none font-mono hover:underline p-0">More →</button>
      </div>

      <!-- Contact Experts -->
      <div>
        <h4 class="font-bold text-white uppercase tracking-widest mb-2 text-[10px]">CONTACT</h4>
        <div class="space-y-1.5">
          <div>
            <span class="text-white text-[10px] font-bold">Dr. Vance</span>
            <span class="text-[#596373] text-[10px] block">Arknights · RPG</span>
          </div>
          <div>
            <span class="text-white text-[10px] font-bold">Marcus Steele</span>
            <span class="text-[#596373] text-[10px] block">War Thunder · Enlisted</span>
          </div>
        </div>
        <div id="experts-more" class="hidden mt-1.5 space-y-1.5">
          <div><span class="text-white text-[10px] font-bold">Yuki Chen</span><span class="text-[#596373] text-[10px] block">NTE · Wuthering Waves</span></div>
          <div><span class="text-white text-[10px] font-bold">Elena Cross</span><span class="text-[#596373] text-[10px] block">RAID · Project Entropy</span></div>
          <div><span class="text-white text-[10px] font-bold">Kai Brooks</span><span class="text-[#596373] text-[10px] block">RoK · Star Trek FC</span></div>
          <div><span class="text-white text-[10px] font-bold">Jason Bench</span><span class="text-[#596373] text-[10px] block">PC Hardware · Setup</span></div>
        </div>
        <a href="mailto:contact@riggamer.com" class="text-[#ff5500] text-[10px] hover:underline block mt-1">contact@riggamer.com</a>
        <button onclick="const el=document.getElementById('experts-more');el.classList.toggle('hidden');this.textContent=el.classList.contains('hidden')?'All experts →':'Less ↑';"
          class="text-[#ff5500] text-[10px] mt-0.5 cursor-pointer bg-transparent border-none font-mono hover:underline p-0">All experts →</button>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="flex flex-col sm:flex-row items-center justify-end text-[10px] font-mono text-[#596373] gap-4">
      <div class="flex items-center gap-5">
        <a href="/privacy/"    class="hover:text-[#ff5500] transition-colors">Privacy</a>
        <a href="/terms/"      class="hover:text-[#ff5500] transition-colors">Terms</a>
        <a href="/disclosure/" class="hover:text-[#ff5500] transition-colors">Disclosure</a>
        <a href="/privacy/"    class="hover:text-[#ff5500] transition-colors">Cookies</a>
      </div>
    </div>

  </div>
</footer>
