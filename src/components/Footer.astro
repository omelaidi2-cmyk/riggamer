---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <!-- Brand col -->
      <div>
        <div class="footer-logo-wrap">
          <svg class="footer-logo-icon" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="26" height="26" fill="#c6ff33" rx="2"/>
            <line x1="5" y1="2" x2="5" y2="4" stroke="#07080b" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="13" y1="2" x2="13" y2="4" stroke="#07080b" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="21" y1="2" x2="21" y2="4" stroke="#07080b" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="5" y1="22" x2="5" y2="24" stroke="#07080b" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="13" y1="22" x2="13" y2="24" stroke="#07080b" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="21" y1="22" x2="21" y2="24" stroke="#07080b" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="2" y1="8" x2="4" y2="8" stroke="#07080b" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="2" y1="13" x2="4" y2="13" stroke="#07080b" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="2" y1="18" x2="4" y2="18" stroke="#07080b" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="22" y1="8" x2="24" y2="8" stroke="#07080b" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="22" y1="13" x2="24" y2="13" stroke="#07080b" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="22" y1="18" x2="24" y2="18" stroke="#07080b" stroke-width="1.2" stroke-linecap="round"/>
            <rect x="4" y="4" width="18" height="18" fill="#07080b" rx="1"/>
            <path d="M8 8 L8 18 M8 8 L14 8 Q17 8 17 11 Q17 14 14 14 L8 14 M14 14 L17 18"
                  stroke="#c6ff33" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <circle cx="18" cy="18" r="1.2" fill="#c6ff33" opacity="0.6"/>
          </svg>
          <span class="footer-logo-txt">Rig<em>Gamer</em></span>
        </div>
        <p class="footer-tagline">The sharpest PC gaming coverage. Guides, reviews, and setup intel — updated daily.</p>
        <p class="footer-copy">© {year} RigGamer.com</p>
      </div>

      <!-- Content col -->
      <div>
        <div class="footer-col-hd">Content</div>
        <ul class="footer-lnks">
          <li><a href="/guides/">Guides</a></li>
          <li><a href="/news/">News</a></li>
          <li><a href="/reviews/">Reviews</a></li>
          <li><a href="/setup/">Setup</a></li>
        </ul>
      </div>

      <!-- Site col -->
      <div>
        <div class="footer-col-hd">The Site</div>
        <ul class="footer-lnks">
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/advertise/">Advertise</a></li>
        </ul>
      </div>

      <!-- Legal col -->
      <div>
        <div class="footer-col-hd">Legal</div>
        <ul class="footer-lnks">
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms of Use</a></li>
          <li><a href="/cookies/">Cookie Policy</a></li>
          <li><a href="/disclosure/">Affiliate Disclosure</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-legal">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="/cookies/">Cookies</a>
      </div>
      <span class="footer-ver">// v1.0.0</span>
    </div>
  </div>
</footer>
