---
export interface Props {
  slug: string;
  size?: 'wide' | 'box' | 'sky' | 'flow';
  img?: string;
  imgW?: number;
  imgH?: number;
  alt?: string;
}

const { slug, size = 'wide', img, imgW, imgH, alt = '' } = Astro.props;

const cls = {
  wide: 'blassa-wide',
  box:  'blassa-box',
  sky:  'blassa-sky',
  flow: 'blassa-flow',
}[size];

const isGif = img?.endsWith('.gif');
const aspectStyle = imgW && imgH ? `display:block;width:100%;aspect-ratio:${imgW}/${imgH};` : 'display:block;width:100%;';
---

<div class={`blassa ${cls}${img ? ' filled' : ''}`}>
  {img ? (
    <a href={`/play/${slug}`} target="_blank" rel="noopener noreferrer" style="display:block;line-height:0;">
      {isGif ? (
        <video autoplay loop muted playsinline width={imgW} height={imgH} style={aspectStyle}>
          <source src={img.replace('.gif', '.webm')} type="video/webm" />
          <source src={img.replace('.gif', '.mp4')} type="video/mp4" />
        </video>
      ) : (
        <img src={img} alt={alt} width={imgW} height={imgH}
          style={aspectStyle}
          referrerpolicy="no-referrer" loading="lazy" decoding="async" />
      )}
    </a>
  ) : (
    <span class="blassa-note">// {slug.toUpperCase()} AD {size.toUpperCase()}</span>
  )}
</div>
