---
// NavBar.astro — Stitch v3 design (pure orange)
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---
<header class="sticky top-0 z-40 bg-[#08090b]/95 backdrop-blur-md border-b border-[#161a22]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">

    <a href="/" class="flex items-center gap-2.5 group shrink-0">
      <div class="w-7 h-7 flex items-center justify-center" style="background:#ff5500;border-radius:3px;">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none">
          <path d="M12 2L2 7l10 5 10-5-10-5z" stroke="#fff" stroke-width="2" stroke-linejoin="round" fill="none"/>
          <path d="M2 12l10 5 10-5" stroke="#fff" stroke-width="2" stroke-linejoin="round"/>
          <path d="M2 17l10 5 10-5" stroke="#fff" stroke-width="2" stroke-linejoin="round"/>
        </svg>
      </div>
      <span class="font-black text-lg tracking-tight uppercase font-mono">
        <span class="text-white">RIG</span><span style="color:#ff5500">GAMER</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-8 font-mono text-[12px] tracking-[0.2em] uppercase">
      <a href="/guides/"  class={`inline-block py-2 px-1 transition-colors duration-150 ${isActive('/guides/')  ? 'text-[#ff5500]' : 'text-[#8b949e] hover:text-[#ff5500]'}`}>GUIDES</a>
      <a href="/news/"    class={`inline-block py-2 px-1 transition-colors duration-150 ${isActive('/news/')    ? 'text-[#ff5500]' : 'text-[#8b949e] hover:text-[#ff5500]'}`}>NEWS</a>
      <a href="/reviews/" class={`inline-block py-2 px-1 transition-colors duration-150 ${isActive('/reviews/') ? 'text-[#ff5500]' : 'text-[#8b949e] hover:text-[#ff5500]'}`}>REVIEWS</a>
      <a href="/setup/"   class={`inline-block py-2 px-1 transition-colors duration-150 ${isActive('/setup/')   ? 'text-[#ff5500]' : 'text-[#8b949e] hover:text-[#ff5500]'}`}>SETUP</a>
    </nav>

    <div class="flex items-center gap-3 shrink-0">
      <div class="relative hidden sm:flex items-center">
        <div class="absolute left-0 pointer-events-none flex items-center justify-center w-8 h-full" style="background:#ff5500;border-radius:3px 0 0 3px;">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none">
            <path d="M12 2L2 7l10 5 10-5-10-5z" stroke="#fff" stroke-width="2" stroke-linejoin="round"/>
            <path d="M2 12l10 5 10-5" stroke="#fff" stroke-width="2" stroke-linejoin="round"/>
            <path d="M2 17l10 5 10-5" stroke="#fff" stroke-width="2" stroke-linejoin="round"/>
          </svg>
        </div>
        <input
          type="text"
          placeholder="SEARCH"
          class="bg-[#12151c]/90 border border-[#232733] focus:border-[#ff5500] text-white text-[11px] font-mono tracking-wider pl-10 pr-3 py-1.5 w-36 lg:w-44 focus:outline-none transition-colors placeholder:text-[#717684] uppercase clip-search-box"
        />
      </div>
      <a
        href="/guides/"
        class="inline-flex items-center justify-center bg-[#c94400] hover:bg-[#a83800] text-white font-mono font-black text-xs uppercase tracking-wider px-4 py-2 transition-all duration-150"
        style="clip-path:polygon(0 0,calc(100% - 8px) 0,100% 8px,100% 100%,8px 100%,0 calc(100% - 8px))"
      >SUBSCRIBE</a>
      <button
        class="md:hidden flex items-center justify-center p-2 text-gray-300 hover:text-white hover:bg-white/5 border border-white/10 rounded transition"
        onclick="const m=document.getElementById('rg-mobile-nav');if(m)m.classList.toggle('hidden');"
        aria-label="Toggle menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="rg-mobile-nav" class="hidden md:hidden border-t border-[#161a22] bg-[#08090b] px-4 py-4 space-y-3 font-mono text-xs uppercase tracking-wider">
    <a href="/guides/"  class={`block py-1.5 transition-colors ${isActive('/guides/')  ? 'text-[#ff5500]' : 'text-gray-200 hover:text-[#ff5500]'}`}>GUIDES</a>
    <a href="/news/"    class={`block py-1.5 transition-colors ${isActive('/news/')    ? 'text-[#ff5500]' : 'text-gray-200 hover:text-[#ff5500]'}`}>NEWS</a>
    <a href="/reviews/" class={`block py-1.5 transition-colors ${isActive('/reviews/') ? 'text-[#ff5500]' : 'text-gray-200 hover:text-[#ff5500]'}`}>REVIEWS</a>
    <a href="/setup/"   class={`block py-1.5 transition-colors ${isActive('/setup/')   ? 'text-[#ff5500]' : 'text-gray-200 hover:text-[#ff5500]'}`}>SETUP</a>
    <div class="pt-2 border-t border-white/10">
      <a href="/guides/" class="flex items-center justify-center bg-[#ff5500] hover:bg-[#e04a00] text-white font-mono font-bold text-xs uppercase px-3.5 py-2.5 transition">SUBSCRIBE</a>
    </div>
  </div>
</header>
